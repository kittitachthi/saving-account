NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://saving_account:saving_account_local@localhost:5432/saving_account?schema=public
# Optional locally; required for Neon migrations so Prisma bypasses the pooler.
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=postgresql://saving_account:saving_account_local@localhost:5432/saving_account?schema=public
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional: configure all SMTP values to send Beta notifications through Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pocka <no-reply@example.com>
