NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://saving_account:saving_account_local@localhost:5432/saving_account?schema=public
TEST_DATABASE_URL=postgresql://saving_account:saving_account_local@localhost:5432/saving_account?schema=public
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Optional: configure all SMTP values to send approved Beta invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pocka <no-reply@example.com>
