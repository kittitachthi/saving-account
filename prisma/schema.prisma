generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
}

enum WalletRole {
  OWNER
  VIEWER
}

enum BetaWaitlistStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NotificationKind {
  BETA_APPROVED
  WALLET_INVITATION
  WALLET_ACCESS_CHANGED
  WAITLIST_WITHDRAWAL
  BETA_RESET_NOTICE
}

enum WalletInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  displayName        String
  avatarUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  pendingDeletionAt  DateTime?
  accountDeletionJob AccountDeletionJob?
  authAccounts       AuthAccount[]
  sessions           Session[]
  ownedWallets       Wallet[]            @relation("WalletOwner")
  memberships        WalletMembership[]
  sentInvitations    WalletInvitation[]  @relation("InvitationSender")
  privacyAcceptances PrivacyAcceptance[]
}

model AuthAccount {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String
  verifiedEmail   String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  ownerId      String              @db.Uuid
  name         String
  timezone     String              @default("Asia/Bangkok")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  owner        User                @relation("WalletOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships  WalletMembership[]
  transactions WalletTransaction[]
  savingsGoal  SavingsGoal?
  invitations  WalletInvitation[]
}

model PrivacyAcceptance {
  userId     String   @db.Uuid
  version    String
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, version])
}

model WalletTransaction {
  id                String    @id @default(uuid()) @db.Uuid
  walletId          String    @db.Uuid
  operationId       String    @db.Uuid
  title             String
  category          String
  type              String
  amount            BigInt
  occurredOn        String    @db.VarChar(10)
  occurredTime      String?   @db.VarChar(5)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deleteOperationId String?   @db.Uuid
  wallet            Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, operationId])
  @@index([walletId, occurredOn])
}

model SavingsGoal {
  walletId  String   @id @db.Uuid
  amount    BigInt
  updatedAt DateTime @updatedAt
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model WalletMembership {
  walletId     String     @db.Uuid
  userId       String     @db.Uuid
  role         WalletRole
  lastViewedAt DateTime?
  wallet       Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([walletId, userId])
}

model WalletInvitation {
  id          String                 @id @default(uuid()) @db.Uuid
  walletId    String                 @db.Uuid
  invitedById String                 @db.Uuid
  email       String
  tokenHash   String                 @unique
  status      WalletInvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?
  wallet      Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  invitedBy   User                   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@index([email, status])
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tokenHash   String   @unique
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  deviceLabel String   @default("อุปกรณ์ไม่ทราบชนิด")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BetaAllowlist {
  email   String   @id
  addedAt DateTime @default(now())
  addedBy String
}

model BetaWaitlistEntry {
  email          String             @id
  status         BetaWaitlistStatus @default(PENDING)
  consentVersion String
  consentedAt    DateTime           @default(now())
  requestedAt    DateTime           @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  approvedAt     DateTime?
}

model BetaWaitlistWithdrawal {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AccountDeletionJob {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  dueAt     DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dueAt])
}

model NotificationOutbox {
  id             String             @id @default(uuid()) @db.Uuid
  kind           NotificationKind
  dedupeKey      String             @unique
  recipientEmail String
  payload        Json
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, nextAttemptAt])
}

model OAuthAttempt {
  stateHash    String   @id
  nonce        String
  codeVerifier String
  returnTo     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
