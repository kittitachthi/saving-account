generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
}

enum WalletRole {
  OWNER
  VIEWER
}

enum BetaWaitlistStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum NotificationKind {
  BETA_APPROVED
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique
  displayName  String
  avatarUrl    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  authAccounts AuthAccount[]
  sessions     Session[]
  ownedWallets Wallet[]           @relation("WalletOwner")
  memberships  WalletMembership[]
}

model AuthAccount {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String
  verifiedEmail   String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
}

model Wallet {
  id          String             @id @default(uuid()) @db.Uuid
  ownerId     String             @db.Uuid
  name        String
  timezone    String             @default("Asia/Bangkok")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  owner       User               @relation("WalletOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships WalletMembership[]
}

model WalletMembership {
  walletId String     @db.Uuid
  userId   String     @db.Uuid
  role     WalletRole
  wallet   Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([walletId, userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BetaAllowlist {
  email     String   @id
  addedAt   DateTime @default(now())
  addedBy   String
}

model BetaWaitlistEntry {
  email          String             @id
  status         BetaWaitlistStatus @default(PENDING)
  consentVersion String
  consentedAt    DateTime           @default(now())
  requestedAt    DateTime           @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  approvedAt     DateTime?
}

model NotificationOutbox {
  id             String             @id @default(uuid()) @db.Uuid
  kind           NotificationKind
  dedupeKey      String             @unique
  recipientEmail String
  payload        Json
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  sentAt         DateTime?
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, nextAttemptAt])
}

model OAuthAttempt {
  stateHash    String   @id
  nonce        String
  codeVerifier String
  returnTo     String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
